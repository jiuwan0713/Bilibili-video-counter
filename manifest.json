{
  "manifest_version": 3,
  "name": "B站观看统计",
  "version": "1.0.0",
  "description": "统计每天 / 每周 / 每月在 B 站网页端看了多少个视频和多久，数据只保存在本机。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "B站观看统计",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
